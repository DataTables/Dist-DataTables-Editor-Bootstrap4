{
    "name": "datatables.net-editor-bs4",
    "description": "Editor for DataTables with styling for [Bootstrap4](https://getbootstrap.com/docs/4.6/getting-started/introduction/)",
    "main": "./js/editor.bootstrap4.js",
    "module": "./js/editor.bootstrap4.mjs",
    "style": "./css/editor.bootstrap4.css",
    "types": "./types/editor.bootstrap4.d.ts",
    "version": "3.1.0",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "Editing",
        "CRUD",
        "Inline",
        "Modal",
        "Multi-row",
        "Bootstrap",
        "Bootstrap4",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-editor": "3.1.0",
        "datatables.net-bs4": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "SEE LICENSE IN License.txt",
    "exports": {
        ".": {
            "types": "./types/editor.bootstrap4.d.ts",
            "import": "./js/editor.bootstrap4.mjs",
            "default": "./js/editor.bootstrap4.mjs",
            "require": "./js/editor.bootstrap4.js"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/editor.bootstrap4.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}